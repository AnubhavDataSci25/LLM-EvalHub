# ---------------------------------------------------------------------------
# LLM-EvalHub — backend environment
#
# Copy to backend/.env and fill in whichever providers you have access to.
# EVERY PROVIDER IS OPTIONAL. The platform reports which are configured and
# degrades honestly rather than failing.
#
# These values are read only by the backend. They are never sent to the browser
# and are redacted from application logs.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- database --------------------------------------------------------------
# SQLite for development; swap the DSN for PostgreSQL in production.
DATABASE_URL=sqlite:///./evalhub.db
# DATABASE_URL=postgresql+psycopg://evalhub:evalhub@localhost:5432/evalhub

# --- providers -------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face Inference Providers — https://huggingface.co/settings/tokens
HF_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM — https://build.nvidia.com
# Leave the key empty and set the base URL if you run a self-hosted NIM endpoint.
NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama — OPTIONAL. Local inference is never required by this platform.
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434

# Deterministic test provider. Keep it on for offline development and tests;
# its output is mechanical and must not be read as a benchmark result.
ENABLE_MOCK_PROVIDER=true

# --- evaluation ------------------------------------------------------------
# Default judge for LLM-scored metrics and AI diagnosis. Leave empty to use
# deterministic evaluators only (reproducible, no extra API cost).
DEFAULT_EVALUATOR_PROVIDER=
DEFAULT_EVALUATOR_MODEL=
ENABLE_LLM_JUDGE=true
ENABLE_RAGAS=false

# --- execution limits ------------------------------------------------------
# Bound provider load. Raise cautiously: free tiers rate-limit aggressively.
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=60
RETRY_ATTEMPTS=2

# --- ingestion limits ------------------------------------------------------
MAX_DATASET_ROWS=5000
MAX_UPLOAD_BYTES=26214400

# --- RAG -------------------------------------------------------------------
# hashing  — deterministic lexical, no download, works anywhere (default)
# gemini   — semantic, requires GEMINI_API_KEY
# sentence-transformers — semantic, requires the optional extra
EMBEDDING_BACKEND=hashing
VECTOR_STORE_BACKEND=auto
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=4

# --- storage ---------------------------------------------------------------
STORAGE_DIR=./storage
